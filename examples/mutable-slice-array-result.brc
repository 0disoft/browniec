module main;

fn i32[2] update(ref mut i32[] child, i32[1] input) {
    child[0] = input[0];
    return [child[0]; 2];
}

fn i32 main() {
    var i32[2] values = [0; 2];
    let i32[1] input = [42; 1];
    let ref mut i32[] parent = ref mut values;
    {
        let ref mut i32[] child = ref mut parent[1..];
        let i32[2] result = update(ref mut child, input);
        if (result[0] != 42 || result[1] != 42 || child[0] != 42) { return 0; }
    }
    return parent[1];
}
