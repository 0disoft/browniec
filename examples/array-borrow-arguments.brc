module main;

struct Answer { i32 value; }

fn Answer update(ref mut i32[] output, ref i32[] input) {
    output[0] = input[0];
    return Answer { .value = output[0] };
}

fn i32 main() {
    var i32[1] output = [0; 1];
    let i32[1] input = [42; 1];
    let Answer answer = update(ref mut output, ref input);
    return answer.value + output[0] - 42;
}
