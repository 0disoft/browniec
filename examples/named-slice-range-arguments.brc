module main;

fn i32 update(ref mut i32[] selected) {
    selected[0] = 42;
    return selected[0];
}

fn i32 main() {
    var i32[4] values = [0; 4];
    let ref mut i32[] parent = ref mut values[1..4];
    let i32 answer = update(ref mut parent[1..2]);
    if (parent[0] != 0 || parent[2] != 0) { return 0; }
    return answer + parent[1] - 42;
}
