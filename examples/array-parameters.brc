module main;

fn i32 weighted(i32[1] before, i32 stamp, i32[1] after) {
    return before[0] * 10 + stamp + after[0];
}

fn i32 main() {
    var i32[1] values = [2; 1];
    let Option<i32> choice = .none;
    return weighted(values, switch (choice) {
        case .some(n): { n }
        case .none: { values[0] = 4; 18 }
    }, values);
}
