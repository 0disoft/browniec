module main;

fn i32 fill(ref mut i32[] selected, ref i32[] input) {
    selected[0] = input[0];
    return selected[0];
}

fn i32 main() {
    var i32[3] output = [0; 3];
    let i32[2] input = [42; 2];
    let i32 answer = fill(ref mut output[1..2], ref input[..1]);
    if (output[0] != 0 || output[2] != 0) { return 0; }
    return answer + output[1] - 42;
}
