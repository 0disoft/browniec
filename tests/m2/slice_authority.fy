module tests::m2::slice_authority;
import slice_authority as authority;
import slice_reborrow as reborrow;
import array_slices as slices;
import array_owners as owners;
import array_layout as layouts;

fn slices::Ticket ticket(Result<slices::Ticket,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);slices::Ticket{.slot=16,.generation=0}}};}
fn usize size(Result<usize,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);0}};}
fn i64 cell(Result<i64,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);0}};}
fn owners::Token create(ref mut owners::Table table,u8 tag,usize n,ref mut u8[] data){
    let layouts::Array shape=switch(layouts::scalar(tag,n)){case .ok(v):{v}case .err(_):{assert(false);layouts::Array{.element=10,.length=1,.stride=1,.alignment=1,.bytes=1}}};
    return switch(owners::create(ref shape,0,data,table)){case .ok(v):{v}case .err(_):{assert(false);owners::Token{.slot=16,.generation=0}}};
}
fn void same_view(owners::View a,owners::View b){assert(a.root.slot==b.root.slot && a.root.generation==b.root.generation && a.element==b.element && a.length==b.length && a.start==b.start && a.end==b.end);}
fn void same_pool(ref slices::Pool a,ref slices::Pool b){var usize i=0;while(i<16){let slices::Slot x=a.slots[i];let slices::Slot y=b.slots[i];assert(x.generation==y.generation && x.live==y.live && x.exclusive==y.exclusive && x.lease.root.slot==y.lease.root.slot && x.lease.root.generation==y.lease.root.generation && x.lease.generation==y.lease.generation);same_view(x.view,y.view);i+=1;}}
fn void same_owners(ref owners::Table a,ref owners::Table b){
    assert(a.depth==b.depth && a.arena.used==b.arena.used && a.arena.limit==b.arena.limit);var usize i=0;while(i<16){let owners::Owner x=a.slots[i];let owners::Owner y=b.slots[i];assert(a.order[i]==b.order[i] && x.generation==y.generation && x.occupied==y.occupied && x.live==y.live && x.reading==y.reading && x.writing==y.writing && x.read_generation==y.read_generation && x.mark==y.mark && x.base==y.base && x.end==y.end && x.element==y.element && x.length==y.length && x.record==y.record && x.alignment==y.alignment);i+=1;}
}


fn slices::Arguments arguments(Result<slices::Arguments,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);slices::empty_arguments()}};}
fn slices::Ticket call(ref mut authority::State state,ref mut slices::Pool pool,slices::Ticket source,ref owners::Table table,usize capacity){let usize frame=state.frame;let slices::Ticket[1] input=[source];let slices::Arguments a=arguments(authority::enter_call(state,pool,ref input,table,capacity,frame));assert(a.count==1);return a.tickets[0];}
fn slices::Ticket leave(ref mut authority::State state,ref mut slices::Pool pool,slices::Ticket source,ref owners::Table table,usize capacity){let usize frame=state.frame;let slices::Ticket[1] input=[source];let slices::Arguments a=arguments(authority::leave_call(state,pool,ref input,table,capacity,frame));assert(a.count==1);return a.tickets[0];}
fn void same_state(ref authority::State a,ref authority::State b){
    assert(a.depth==b.depth && a.frame==b.frame);var usize i=0;while(i<31){assert(a.kinds[i]==b.kinds[i] && a.frames[i]==b.frames[i] && a.counts[i]==b.counts[i] && a.reserves[i]==b.reserves[i]);let reborrow::Loan x=a.children[i];let reborrow::Loan y=b.children[i];same_view(x.parent.view,y.parent.view);same_view(x.selected,y.selected);assert(x.parent.generation==y.parent.generation && x.issued.slot==y.issued.slot && x.issued.generation==y.issued.generation && x.depth==y.depth && x.active==y.active);i+=1;}
    i=0;while(i<248){assert(a.tickets[i].slot==b.tickets[i].slot && a.tickets[i].generation==b.tickets[i].generation && a.leases[i].generation==b.leases[i].generation);same_view(a.leases[i].view,b.leases[i].view);i+=1;}
}
@test
fn void six_scalar_children_and_calls_share_receipts_and_restore_exact_ranges(){
    let u8[6] tags=[1,2,9,10,11,12];let i64[6] values=[-2147483648,1,-9223372036854775807-1,255,4294967295,-1];var usize i=0;
    while(i<6){var u8[40] data=[0;40];var owners::Table table=owners::empty(40);var slices::Pool pool=slices::empty();var authority::State state=authority::empty();let owners::Token root=create(ref mut table,tags[i],5,ref mut data);let slices::Ticket parent=ticket(slices::open_exclusive(ref mut pool,ref mut table,root,0,5,40));let owners::Table before=table;
        let slices::Ticket a=ticket(authority::enter_child(ref mut state,ref mut pool,parent,ref table,1,4,40,0));let slices::Ticket b=call(ref mut state,ref mut pool,a,ref table,40);let slices::Ticket c=ticket(authority::enter_child(ref mut state,ref mut pool,b,ref table,1,2,40,1));let slices::Ticket d=call(ref mut state,ref mut pool,c,ref table,40);
        assert(state.depth==4 && state.frame==2 && state.reserves[3]==3 && size(slices::length(ref pool,d,ref table,40))==1);assert(!slices::read(ref pool,parent,ref table,0,ref data).is_ok && !owners::read(ref table,root,2,ref data).is_ok);assert(slices::write(ref pool,d,ref table,0,values[i],ref mut data).is_ok);
        let slices::Ticket e=leave(ref mut state,ref mut pool,d,ref table,40);let slices::Ticket f=ticket(authority::leave_child(ref mut state,ref mut pool,e,ref table,40,1));let slices::Ticket g=leave(ref mut state,ref mut pool,f,ref table,40);let slices::Ticket h=ticket(authority::leave_child(ref mut state,ref mut pool,g,ref table,40,0));
        assert(state.depth==0 && state.frame==0 && h.slot==parent.slot && h.generation==parent.generation+8 && size(slices::length(ref pool,h,ref table,40))==5);same_owners(ref table,ref before);assert(!slices::read(ref pool,d,ref table,0,ref data).is_ok && cell(slices::read(ref pool,h,ref table,2,ref data))==values[i]);assert(slices::close(ref mut pool,h,ref mut table,40).is_ok);i+=1;
    }
}
@test
fn void thirty_one_mixed_restores_fit_and_the_next_call_or_child_is_atomic(){
    var u8[8] data=[0;8];var owners::Table table=owners::empty(8);var slices::Pool pool=slices::empty();var authority::State state=authority::empty();let owners::Token root=create(ref mut table,10,1,ref mut data);let slices::Ticket parent=ticket(slices::open_exclusive(ref mut pool,ref mut table,root,0,1,8));var slices::Ticket current=parent;var usize d=0;
    while(d<31){let usize frame=state.frame;current=if(d%2==0){ticket(authority::enter_child(ref mut state,ref mut pool,current,ref table,0,1,8,frame))}else{call(ref mut state,ref mut pool,current,ref table,8)};d+=1;}
    assert(state.depth==31 && state.frame==15);let slices::Pool saved=pool;let authority::State before=state;let slices::Ticket[1] input=[current];assert(!authority::enter_call(ref mut state,ref mut pool,ref input,ref table,8,15).is_ok && !authority::enter_child(ref mut state,ref mut pool,current,ref table,0,1,8,15).is_ok);same_pool(ref pool,ref saved);same_state(ref state,ref before);assert(slices::write(ref pool,current,ref table,0,42,ref mut data).is_ok);
    while(d>0){d-=1;let usize frame=state.frame;current=if(d%2==0){ticket(authority::leave_child(ref mut state,ref mut pool,current,ref table,8,frame))}else{leave(ref mut state,ref mut pool,current,ref table,8)};}
    assert(state.depth==0 && state.frame==0 && current.generation==parent.generation+62 && cell(slices::read(ref pool,current,ref table,0,ref data))==42);assert(slices::close(ref mut pool,current,ref mut table,8).is_ok);
}
@test
fn void call_generation_reserves_include_pending_lexical_restores(){
    var u8[8] data=[0;8];var owners::Table table=owners::empty(8);var slices::Pool pool=slices::empty();var authority::State state=authority::empty();let owners::Token root=create(ref mut table,10,1,ref mut data);var slices::Ticket current=ticket(slices::open_exclusive(ref mut pool,ref mut table,root,0,1,8));var usize i=0;while(i<6){current=ticket(authority::enter_child(ref mut state,ref mut pool,current,ref table,0,1,8,0));i+=1;}
    pool.slots[current.slot].generation=18446744073709551615-7;current.generation=18446744073709551615-7;let slices::Pool saved=pool;let authority::State before=state;let slices::Ticket[1] input=[current];assert(!authority::enter_call(ref mut state,ref mut pool,ref input,ref table,8,0).is_ok && !authority::enter_child(ref mut state,ref mut pool,current,ref table,0,1,8,0).is_ok);same_pool(ref pool,ref saved);same_state(ref state,ref before);
    pool.slots[current.slot].generation=18446744073709551615-8;current.generation=18446744073709551615-8;current=call(ref mut state,ref mut pool,current,ref table,8);assert(state.reserves[6]==6 && state.frame==1);current=leave(ref mut state,ref mut pool,current,ref table,8);while(i>0){current=ticket(authority::leave_child(ref mut state,ref mut pool,current,ref table,8,0));i-=1;}assert(current.generation==18446744073709551615 && state.depth==0);assert(slices::close(ref mut pool,current,ref mut table,8).is_ok && pool.slots[current.slot].generation==0);
}
@test
fn void wrong_frames_order_stale_and_duplicate_inputs_fail_before_publication(){
    var u8[8] data=[0;8];var owners::Table table=owners::empty(8);var slices::Pool pool=slices::empty();var authority::State state=authority::empty();let owners::Token a=create(ref mut table,10,1,ref mut data);let owners::Token b=create(ref mut table,10,1,ref mut data);let slices::Ticket x=ticket(slices::open_exclusive(ref mut pool,ref mut table,a,0,1,8));let slices::Ticket y=ticket(slices::open_exclusive(ref mut pool,ref mut table,b,0,1,8));let slices::Ticket child=ticket(authority::enter_child(ref mut state,ref mut pool,x,ref table,0,1,8,0));let slices::Pool saved=pool;let authority::State before=state;let slices::Ticket[2] duplicate=[child,child];let slices::Ticket[2] stale=[child,slices::Ticket{.slot=y.slot,.generation=y.generation+1}];
    assert(!authority::enter_call(ref mut state,ref mut pool,ref duplicate,ref table,8,0).is_ok && !authority::enter_call(ref mut state,ref mut pool,ref stale,ref table,8,0).is_ok && !authority::enter_call(ref mut state,ref mut pool,ref duplicate[..1],ref table,8,1).is_ok);assert(!authority::leave_call(ref mut state,ref mut pool,ref duplicate[..1],ref table,8,0).is_ok && !authority::leave_child(ref mut state,ref mut pool,child,ref table,8,1).is_ok);same_pool(ref pool,ref saved);same_state(ref state,ref before);
    let slices::Ticket[2] input=[child,y];let slices::Arguments entered=arguments(authority::enter_call(ref mut state,ref mut pool,ref input,ref table,8,0));let slices::Pool called=pool;let authority::State call_before=state;let slices::Ticket[2] wrong=[entered.tickets[0],y];assert(!authority::leave_call(ref mut state,ref mut pool,ref wrong,ref table,8,1).is_ok && !authority::leave_child(ref mut state,ref mut pool,entered.tickets[0],ref table,8,1).is_ok);same_pool(ref pool,ref called);same_state(ref state,ref call_before);
    let slices::Arguments returned=arguments(authority::leave_call(ref mut state,ref mut pool,ref entered.tickets[..2],ref table,8,1));let slices::Ticket resumed=ticket(authority::leave_child(ref mut state,ref mut pool,returned.tickets[0],ref table,8,0));assert(slices::close(ref mut pool,resumed,ref mut table,8).is_ok && slices::close(ref mut pool,returned.tickets[1],ref mut table,8).is_ok);
}
@test
fn void full_pool_abort_preserves_writes_and_failed_drain_preserves_every_receipt(){
    var u8[16] data=[0;16];var owners::Table table=owners::empty(16);var slices::Pool pool=slices::empty();var authority::State state=authority::empty();var slices::Ticket[8] sources=[slices::Ticket{.slot=16,.generation=0};8];var owners::Token[16] roots=[owners::Token{.slot=16,.generation=0};16];var usize i=0;
    while(i<16){roots[i]=create(ref mut table,10,1,ref mut data);let slices::Ticket opened=ticket(slices::open_exclusive(ref mut pool,ref mut table,roots[i],0,1,16));if(i<8){sources[i]=opened;}i+=1;}
    let slices::Arguments entered=arguments(authority::enter_call(ref mut state,ref mut pool,ref sources,ref table,16,0));let slices::Ticket child=ticket(authority::enter_child(ref mut state,ref mut pool,entered.tickets[0],ref table,0,1,16,1));assert(slices::write(ref pool,child,ref table,0,42,ref mut data).is_ok);let usize epoch=table.slots[15].read_generation;table.slots[15].read_generation+=1;let slices::Pool saved=pool;let owners::Table owners_before=table;let authority::State before=state;
    assert(!authority::finish(ref mut state,ref mut pool,ref mut table,16).is_ok);same_pool(ref pool,ref saved);same_owners(ref table,ref owners_before);same_state(ref state,ref before);table.slots[15].read_generation=epoch;assert(size(authority::finish(ref mut state,ref mut pool,ref mut table,16))==16 && table.depth==16 && table.arena.used==16);let authority::State clear=authority::empty();same_state(ref state,ref clear);i=0;while(i<16){assert(!pool.slots[i].live && !table.slots[i].writing);i+=1;}assert(cell(owners::read(ref table,roots[0],0,ref data))==42 && !authority::leave_child(ref mut state,ref mut pool,child,ref table,16,0).is_ok);
}
@test
fn void empty_calls_consume_depth_and_corrupt_ownership_is_rejected_then_abortable(){
    var owners::Table table=owners::empty(0);var slices::Pool pool=slices::empty();var authority::State state=authority::empty();let slices::Ticket[1] none=[slices::Ticket{.slot=16,.generation=0}];var usize i=0;while(i<31){let slices::Arguments a=arguments(authority::enter_call(ref mut state,ref mut pool,ref none[..0],ref table,0,i));assert(a.count==0);i+=1;}assert(state.depth==31 && state.frame==31);assert(!authority::enter_call(ref mut state,ref mut pool,ref none[..0],ref table,0,31).is_ok);while(i>0){let slices::Arguments a=arguments(authority::leave_call(ref mut state,ref mut pool,ref none[..0],ref table,0,i));assert(a.count==0);i-=1;}
    let slices::Arguments a=arguments(authority::enter_call(ref mut state,ref mut pool,ref none[..0],ref table,0,0));state.frames[0]=1;let authority::State before=state;let slices::Pool saved=pool;assert(!authority::enter_call(ref mut state,ref mut pool,ref none[..0],ref table,0,1).is_ok && !authority::leave_call(ref mut state,ref mut pool,ref none[..0],ref table,0,1).is_ok);same_state(ref state,ref before);same_pool(ref pool,ref saved);state.frames[0]=0;let slices::Arguments b=arguments(authority::leave_call(ref mut state,ref mut pool,ref none[..0],ref table,0,1));state.depth=32;assert(!authority::enter_call(ref mut state,ref mut pool,ref none[..0],ref table,0,0).is_ok);assert(size(authority::finish(ref mut state,ref mut pool,ref mut table,0))==0);let authority::State clear=authority::empty();same_state(ref state,ref clear);
}
