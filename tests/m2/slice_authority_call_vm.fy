module tests::m2::slice_authority_call_vm;
import slice_mutable_call_vm as legacy;
import slice_authority_call_vm as calls;
import slice_authority as authority;
import slice_reborrow_ir as proof;
import slice_call_vm as shared;
import slice_vm as loans;
import array_vm as arrays;
import array_slices as slices;
import array_owners as owners;
import array_layout as layouts;
import struct_vm as records;
import struct_call_vm as owned;
import slice_builders as builders;
import compiler as compiler;
import verifier as verifier;
import vm as vm;
import ir as ir;
import errors as errors;
import std::bytes as bytes;

fn usize built(Result<usize,errors::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);0}};}
fn usize count(Result<usize,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);0}};}
fn i64 cell(Result<i64,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);0}};}
fn owners::Token token(Result<owners::Token,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);owners::Token{.slot=16,.generation=0}}};}
fn slices::Ticket ticket(Result<slices::Ticket,owners::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);slices::Ticket{.slot=16,.generation=0}}};}
fn bytes::Buffer backing(){return switch(arrays::prepare(256)){case .ok(v):{v}case .err(_):{assert(false);bytes::empty()}};}
fn usize pc(ref ir::Program p,usize f){var usize i=p.starts[f];while(i<p.ends[f] && p.code[i*8]!=9){i+=1;}assert(i<p.ends[f]);return i;}
fn void finish(ref mut ir::Program p,usize f){let usize end=p.count;let usize regs=p.registers;p.ends[f]=end;p.register_ends[f]=regs;}
fn void inspected(ref ir::Program p){assert(verifier::inspect(p).is_ok && verifier::verify(p).is_ok);assert(switch(vm::run_with_array_limit(p,0,0)){case .ok(_):{false}case .err(e):{e.kind==8}});}
fn ir::Program program(u8 tag,bool recursive){
    var ir::Program p=ir::empty();p.function_count=2;p.entry=1;p.arities[0]=1;p.return_types[0]=1;p.return_types[1]=1;
    let usize formal=built(builders::parameter_exclusive(ref mut p,0,tag,77));let usize[1] forwarded=[160+formal];let usize value=built(if(recursive){ir::call(ref mut p,0,ref forwarded,77)}else{ir::literal(ref mut p,42,77)});let usize close=built(ir::slice_close(ref mut p,formal,77));let usize ret=built(ir::emit(ref mut p,8,value,0,77));finish(ref mut p,0);
    let usize start=p.count;let usize regs=p.registers;p.starts[1]=start;p.register_starts[1]=regs;let usize root=built(ir::array_in(ref mut p,1,tag,3,true,77));let usize site=built(ir::exclusive_slice(ref mut p,root,77));let usize fill=built(if(tag==2){ir::boolean(ref mut p,false,77)}else{ir::integer(ref mut p,0,tag,77)});let usize init=built(ir::array_init(ref mut p,root,fill,77));let usize lo=built(ir::integer(ref mut p,0,12,77));let usize hi=built(ir::integer(ref mut p,3,12,77));let usize open=built(ir::slice_open(ref mut p,site,lo,hi,77));let usize[1] args=[160+site];let usize result=built(ir::call(ref mut p,0,ref args,77));let usize closed=built(ir::slice_close(ref mut p,site,77));let usize drop=built(ir::array_drop(ref mut p,root,77));let usize done=built(ir::emit(ref mut p,8,result,0,77));finish(ref mut p,1);inspected(ref p);return p;
}
fn owners::Token create(ref mut arrays::State state,u8 tag,usize length,i64 fill,ref mut bytes::Buffer buffer){
    let layouts::Array shape=switch(layouts::scalar(tag,length)){case .ok(v):{v}case .err(_):{assert(false);layouts::Array{.element=10,.length=1,.stride=1,.alignment=1,.bytes=1}}};return token(owners::create(ref shape,fill,bytes::view_mut(buffer),ref mut state.owners));
}
fn void initialize(ref ir::Program p,ref mut loans::State l,ref mut arrays::State a,ref mut bytes::Buffer b,bool empty){
    let owners::Token root=create(a,p.arrays.elements[0],3,0,b);a.tokens[0]=root;let slices::Ticket opened=ticket(slices::open_exclusive(ref mut l.pool,ref mut a.owners,root,if(empty){3}else{1},if(empty){3}else{2},256));l.tickets[1]=opened;
}

fn proof::Sites sites(ref ir::Program p){return switch(proof::metadata(p)){case .ok(v):{v}case .err(_):{assert(false);proof::Sites{.parents=[16;16],.newer=[0;16],.count=0}}};}
fn void fail_at(Result<usize,errors::Error> r,u8 kind,usize offset){assert(switch(r){case .ok(_):{false}case .err(e):{e.kind==kind && e.offset==offset}});}
fn void fail(Result<usize,errors::Error> r,u8 kind){assert(switch(r){case .ok(_):{false}case .err(e):{e.kind==kind && e.offset==77}});}
fn owners::View view(Result<owners::View,errors::Error> r){return switch(r){case .ok(v):{v}case .err(_):{assert(false);owners::View{.root=owners::Token{.slot=16,.generation=0},.element=0,.length=0,.start=0,.end=0}}};}
fn void same_view(owners::View a,owners::View b){assert(a.root.slot==b.root.slot && a.root.generation==b.root.generation && a.element==b.element && a.length==b.length && a.start==b.start && a.end==b.end);}
fn void same_pool(ref slices::Pool a,ref slices::Pool b){var usize i=0;while(i<16){assert(a.slots[i].generation==b.slots[i].generation && a.slots[i].live==b.slots[i].live && a.slots[i].exclusive==b.slots[i].exclusive && a.slots[i].lease.generation==b.slots[i].lease.generation);same_view(a.slots[i].view,b.slots[i].view);i+=1;}}
fn void cleared(ref calls::Bindings links,ref authority::State receipts,ref loans::State l,ref shared::Frames f){assert(receipts.depth==0 && receipts.frame==0);var usize i=0;while(i<31){assert(links.pcs[i]==256);i+=1;}i=0;while(i<248){assert(links.detached[i].slot==16 && links.detached[i].generation==0);i+=1;}i=0;while(i<512){assert(l.tickets[i].slot==16 && l.tickets[i].generation==0);i+=1;}i=0;while(i<256){assert(f.origins[i].slot==16 && f.origins[i].generation==0);i+=1;}}
@test
fn void six_scalar_calls_publish_canonical_bindings_charge_exact_fuel_and_restore_live_or_detached(){
    let u8[6] tags=[1,2,9,10,11,12];let i64[6] cells=[-2147483648,1,-9223372036854775807-1,255,4294967295,-1];var usize i=0;while(i<6){let ir::Program p=program(tags[i],false);let proof::Sites map=sites(ref p);var arrays::State a=arrays::empty(256);var records::State s=records::empty();var loans::State l=loans::empty();var bytes::Buffer b=backing();var shared::Frames f=shared::empty();var calls::Bindings links=calls::empty();var authority::State auth=authority::empty();initialize(ref p,ref mut l,ref mut a,ref mut b,false);let usize at=pc(ref p,1);let usize price=built(calls::cost(ref p,at,77));assert(price==built(legacy::cost(ref p,0,77)));let slices::Ticket original=l.tickets[1];let slices::Pool saved=l.pool;
        fail(calls::enter(ref p,ref map,at,0,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,price-1),8);same_pool(ref l.pool,ref saved);assert(auth.depth==0 && links.pcs[0]==256 && l.tickets[1].generation==original.generation);
        assert(built(calls::enter(ref p,ref map,at,0,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,price))==0);assert(auth.depth==1 && auth.frame==1 && auth.counts[0]==1 && links.pcs[0]==at && l.tickets[1].generation==0);let owners::View selected=view(calls::view(ref p,0,1,0,ref links,ref auth,ref f,ref l,ref a,256,77));assert(selected.start==1 && selected.end==2);assert(slices::write(ref l.pool,l.tickets[16],ref a.owners,0,cells[i],bytes::view_mut(ref mut b)).is_ok);
        if(i%2==0){fail(calls::release(ref p,0,1,0,ref mut links,ref auth,ref f,ref mut l,ref a,ref b,4096,77),8);assert(built(calls::release(ref p,0,1,0,ref mut links,ref auth,ref f,ref mut l,ref a,ref b,4097,77))==0 && links.detached[0].generation!=0 && l.tickets[16].generation==0);assert(!calls::view(ref p,0,1,0,ref links,ref auth,ref f,ref l,ref a,256,77).is_ok);}
        assert(built(calls::leave(ref p,0,1,ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref s,ref b,77))==1);assert(auth.depth==0 && auth.frame==0 && links.pcs[0]==256 && l.tickets[1].generation==original.generation+2 && cell(slices::read(ref l.pool,l.tickets[1],ref a.owners,0,bytes::view(ref b)))==cells[i]);let slices::Ticket current=l.tickets[1];assert(slices::close(ref mut l.pool,current,ref mut a.owners,256).is_ok);i+=1;
    }
}
@test
fn void thirty_one_recursive_calls_keep_origins_after_forwarding_and_restore_fresh_tickets(){
    let ir::Program p=program(10,true);let proof::Sites map=sites(ref p);var arrays::State a=arrays::empty(256);var records::State s=records::empty();var loans::State l=loans::empty();var bytes::Buffer b=backing();var shared::Frames f=shared::empty();var calls::Bindings links=calls::empty();var authority::State auth=authority::empty();initialize(ref p,ref mut l,ref mut a,ref mut b,false);let slices::Ticket original=l.tickets[1];var usize depth=0;while(depth<31){let usize at=pc(ref p,if(depth==0){1}else{0});let usize rem=built(calls::enter(ref p,ref map,at,depth,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,1000000));depth+=1;}
    fail(calls::enter(ref p,ref map,pc(ref p,0),31,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,1000000),12);assert(!calls::view(ref p,0,30,0,ref links,ref auth,ref f,ref l,ref a,256,77).is_ok);let owners::Token origin=switch(calls::origin(ref p,0,1,0,ref links,ref auth,ref f,ref a,77)){case .ok(v):{v}case .err(_):{assert(false);owners::Token{.slot=16,.generation=0}}};assert(origin.slot==a.tokens[0].slot);let owners::View selected=view(calls::view(ref p,0,31,0,ref links,ref auth,ref f,ref l,ref a,256,77));assert(slices::write(ref l.pool,l.tickets[31*16],ref a.owners,0,42,bytes::view_mut(ref mut b)).is_ok);
    while(depth>0){let usize remaining=built(calls::release(ref p,0,depth,0,ref mut links,ref auth,ref f,ref mut l,ref a,ref b,4097,77));let usize count=built(calls::leave(ref p,0,depth,ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref s,ref b,77));depth-=1;}
    assert(l.tickets[1].generation==original.generation+62 && auth.depth==0 && auth.frame==0 && cell(slices::read(ref l.pool,l.tickets[1],ref a.owners,0,bytes::view(ref b)))==42);let slices::Ticket current=l.tickets[1];assert(slices::close(ref mut l.pool,current,ref mut a.owners,256).is_ok);
}
fn ir::Program mixed(){let ir::Program p=switch(compiler::compile(b"module main;fn i32 f(ref mut u8[] a,i32 n,ref mut u8[] b){return n;}fn i32 main(){var u8[2] a=[0;2];var u8[2] b=[0;2];let ref mut u8[] p=ref mut a;let ref mut u8[] q=ref mut b;return f(ref mut p,42,ref mut q);}")){case .ok(v):{v}case .err(_):{assert(false);ir::empty()}};inspected(ref p);return p;}
fn void mixed_setup(ref ir::Program p,ref mut arrays::State a,ref mut loans::State l,ref mut bytes::Buffer b){var usize root=0;while(root<2){let owners::Token t=create(a,10,2,0,b);a.tokens[root]=t;root+=1;}let usize at=pc(p,1);let usize args=(p.code[at*8+3] as usize)*8;let usize[2] positions=[0,2];var usize i=0;while(i<2){let usize site=(p.call_args[args+positions[i]] as usize)-160;let usize id=(p.slice_roots[site] as usize)-1;let owners::Token token=a.tokens[id];let slices::Ticket opened=ticket(slices::open_exclusive(ref mut l.pool,ref mut a.owners,token,0,1,256));l.tickets[site]=opened;i+=1;}}
@test
fn void immutable_scalar_interleaving_and_late_multiargument_return_failure_publish_atomically(){
    let ir::Program p=mixed();let proof::Sites map=sites(ref p);var arrays::State a=arrays::empty(256);var records::State s=records::empty();var loans::State l=loans::empty();var bytes::Buffer b=backing();var shared::Frames f=shared::empty();var calls::Bindings links=calls::empty();var authority::State auth=authority::empty();mixed_setup(ref p,ref mut a,ref mut l,ref mut b);let usize at=pc(ref p,1);let usize first=(p.slice_parameters[p.register_starts[0]] as usize)-1;let usize second=(p.slice_parameters[p.register_starts[0]+2] as usize)-1;let usize charge=built(calls::cost(ref p,at,77));assert(charge==built(legacy::cost(ref p,0,77)));let usize rem=built(calls::enter(ref p,ref map,at,0,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,charge));assert(auth.counts[0]==2 && f.origins[9].slot==16);
    let owners::Token saved_origin=f.origins[10];let owners::Token wrong_origin=f.origins[8];f.origins[10]=wrong_origin;assert(!calls::view(ref p,0,1,first,ref links,ref auth,ref f,ref l,ref a,256,77).is_ok);f.origins[10]=saved_origin;let usize generation=l.tickets[16+second].generation;l.tickets[16+second].generation+=1;let slices::Pool saved=l.pool;fail(calls::leave(ref p,0,1,ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref s,ref b,77),5);same_pool(ref l.pool,ref saved);assert(auth.depth==1 && auth.frame==1 && links.pcs[0]==at);l.tickets[16+second].generation=generation;
    let usize old_pc=links.pcs[0];links.pcs[0]=256;fail_at(calls::enter(ref p,ref map,at,1,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,charge-1),8,p.offsets[at]);assert(!calls::view(ref p,0,1,first,ref links,ref auth,ref f,ref l,ref a,256,77).is_ok);links.pcs[0]=old_pc;let usize result=built(calls::leave(ref p,0,1,ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref s,ref b,77));assert(result==2 && auth.depth==0);
}
@test
fn void combined_generation_depth_counts_unrelated_native_subranges_before_call_admission(){
    let ir::Program p=program(10,true);let proof::Sites map=sites(ref p);var arrays::State a=arrays::empty(256);var records::State s=records::empty();var loans::State l=loans::empty();var bytes::Buffer b=backing();var shared::Frames f=shared::empty();var calls::Bindings links=calls::empty();var authority::State auth=authority::empty();initialize(ref p,ref mut l,ref mut a,ref mut b,false);let owners::Token extra=create(ref mut a,10,1,0,ref mut b);var slices::Ticket aux=ticket(slices::open_exclusive(ref mut l.pool,ref mut a.owners,extra,0,1,256));var usize i=0;while(i<30){aux=ticket(authority::enter_child(ref mut auth,ref mut l.pool,aux,ref a.owners,0,1,256,0));i+=1;}
    let usize slot=l.tickets[1].slot;l.pool.slots[slot].generation=18446744073709551615-31;l.tickets[1].generation=18446744073709551615-31;let slices::Pool saved=l.pool;fail(calls::enter(ref p,ref map,pc(ref p,1),0,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,1000000),5);same_pool(ref l.pool,ref saved);assert(auth.depth==30 && auth.frame==0 && links.pcs[30]==256);
    l.pool.slots[slot].generation-=1;l.tickets[1].generation-=1;let usize rem=built(calls::enter(ref p,ref map,pc(ref p,1),0,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,1000000));assert(auth.depth==31 && auth.reserves[30]==30);fail(calls::enter(ref p,ref map,pc(ref p,0),1,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,1000000),12);let usize returned=built(calls::leave(ref p,0,1,ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref s,ref b,77));assert(l.tickets[1].generation==18446744073709551615-30);
    while(i>0){aux=ticket(authority::leave_child(ref mut auth,ref mut l.pool,aux,ref a.owners,256,0));i-=1;}assert(auth.depth==0 && slices::close(ref mut l.pool,aux,ref mut a.owners,256).is_ok);
}
@test
fn void abort_keeps_detached_writes_original_outcomes_and_failed_cleanup_maps(){
    let ir::Program p=program(10,false);let proof::Sites map=sites(ref p);var arrays::State a=arrays::empty(256);var records::State s=records::empty();var loans::State l=loans::empty();var bytes::Buffer b=backing();var shared::Frames f=shared::empty();var calls::Bindings links=calls::empty();var authority::State auth=authority::empty();initialize(ref p,ref mut l,ref mut a,ref mut b,false);let usize rem=built(calls::enter(ref p,ref map,pc(ref p,1),0,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,1000000));let owners::View selected=view(calls::view(ref p,0,1,0,ref links,ref auth,ref f,ref l,ref a,256,77));assert(slices::write(ref l.pool,l.tickets[16],ref a.owners,0,42,bytes::view_mut(ref mut b)).is_ok);let usize released=built(calls::release(ref p,0,1,0,ref mut links,ref auth,ref f,ref mut l,ref a,ref b,4097,77));let usize epoch=a.owners.slots[0].read_generation;a.owners.slots[0].read_generation+=1;let slices::Pool saved=l.pool;
    assert(switch(calls::finish(ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref b,.err(errors::make(8,77)))){case .ok(_):{false}case .err(e):{e.kind==5 && e.offset==0}});same_pool(ref l.pool,ref saved);assert(auth.depth==1 && links.pcs[0]!=256 && links.detached[0].generation!=0 && f.origins[8].generation!=0);a.owners.slots[0].read_generation=epoch;assert(switch(calls::finish(ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref b,.err(errors::make(8,77)))){case .ok(_):{false}case .err(e):{e.kind==8 && e.offset==77}});cleared(ref links,ref auth,ref l,ref f);assert(cell(owners::read(ref a.owners,a.tokens[0],1,bytes::view(ref b)))==42);assert(switch(calls::finish(ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref b,.ok(42))){case .ok(v):{v==42}case .err(_):{false}});
}
@test
fn void empty_ranges_public_legacy_execution_and_unsupported_private_modes_remain_explicit(){
    let ir::Program p=program(10,false);let proof::Sites map=sites(ref p);var arrays::State a=arrays::empty(256);var records::State s=records::empty();var loans::State l=loans::empty();var bytes::Buffer b=backing();var shared::Frames f=shared::empty();var calls::Bindings links=calls::empty();var authority::State auth=authority::empty();initialize(ref p,ref mut l,ref mut a,ref mut b,true);let usize rem=built(calls::enter(ref p,ref map,pc(ref p,1),0,ref mut links,ref mut auth,ref mut f,ref mut l,ref a,ref s,ref b,1000000));let owners::View selected=view(calls::view(ref p,0,1,0,ref links,ref auth,ref f,ref l,ref a,256,77));assert(selected.start==selected.end);let usize returned=built(calls::leave(ref p,0,1,ref mut links,ref mut auth,ref mut f,ref mut l,ref mut a,ref s,ref b,77));assert(switch(vm::run_with_array_limit(ref p,1000000,256)){case .ok(v):{v==42}case .err(_):{false}});
    let ir::Program readonly=switch(compiler::compile(b"module main;fn i32 f(ref u8[] p){return 42;}fn i32 main(){let u8[1] a=[0;1];let ref u8[] p=ref a;return f(ref p);}")){case .ok(v):{v}case .err(_):{assert(false);ir::empty()}};assert(built(calls::cost(ref readonly,pc(ref readonly,1),77))==131076);let ir::Program owned=switch(compiler::compile(b"module main;fn i32 f(u8[1] a){return 42;}fn i32 main(){let u8[1] a=[0;1];return f(a);}")){case .ok(v):{v}case .err(_):{assert(false);ir::empty()}};assert(built(calls::cost(ref owned,pc(ref owned,1),77))==266);
}
