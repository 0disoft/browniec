diff --git a/internal/cbackend/application_bindings.go b/internal/cbackend/application_bindings.go
new file mode 100644
index 0000000000000000000000000000000000000000..26012f766cfc18b7a27feea47c4b3be63d4eb56d
--- /dev/null
+++ b/internal/cbackend/application_bindings.go
@@ -0,0 +1,66 @@
+package cbackend
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/0disoft/fairyc/internal/hir"
+	"github.com/0disoft/fairyc/internal/mir"
+)
+
+func privateApplicationRoots(functions []mir.Function, entry string, names []string) ([]int, error) {
+	if len(names) == 0 {
+		return nil, nil
+	}
+	prefix, valid := strings.CutSuffix(entry, "main::main")
+	if !valid {
+		return nil, fmt.Errorf("private application bindings require a workspace main entry")
+	}
+	indices := make(map[string]int, len(names))
+	for _, name := range names {
+		indices[prefix+name] = -1
+	}
+	for i, fn := range functions {
+		if old, wanted := indices[fn.Name]; wanted {
+			if old >= 0 {
+				return nil, fmt.Errorf("ambiguous private application function %q", fn.Name)
+			}
+			indices[fn.Name] = i
+		}
+	}
+	roots := make([]int, 0, len(names))
+	for _, name := range names {
+		index := indices[prefix+name]
+		if index < 0 || functions[index].InlineBody != "" || functions[index].DropGlueFor != (hir.Type{}) || functions[index].ClosureTarget {
+			return nil, fmt.Errorf("missing or unsupported private application function %q", name)
+		}
+		roots = append(roots, index)
+	}
+	return roots, nil
+}
+
+// These aliases and layouts belong to the same build as the generated C functions.
+func (e *emitter) emitPrivateApplicationBindings(out *strings.Builder, entry string, names []string) {
+	prefix, _ := strings.CutSuffix(entry, "main::main")
+	requested := make(map[string]bool, len(names))
+	for _, name := range names {
+		requested[prefix+name] = true
+	}
+	out.WriteString("#ifdef FY_PROJECT_PRIVATE_BINDINGS\n")
+	for i, fn := range e.analysis.functions {
+		if requested[fn.Name] {
+			fmt.Fprintf(out, "#define fy_private_fn_%x fy_fn_%d\n", strings.TrimPrefix(fn.Name, prefix), i)
+		}
+	}
+	for i, record := range e.analysis.structTypes {
+		if name, ok := strings.CutPrefix(record.definition.Type.String(), prefix); ok && !record.definition.ReprC {
+			fmt.Fprintf(out, "#define fy_private_type_%x fy_struct_%d\n", name, i)
+		}
+	}
+	for i, resource := range e.analysis.resourceTypes {
+		if name, ok := strings.CutPrefix(resource.definition.Type.String(), prefix); ok {
+			fmt.Fprintf(out, "#define fy_private_type_%x fy_resource_%d\n", name, i)
+		}
+	}
+	out.WriteString("#endif\n")
+}
